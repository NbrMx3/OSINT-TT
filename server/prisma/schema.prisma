generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMINISTRATOR
  ANALYST
  INVESTIGATOR
  READ_ONLY
}

enum InvestigationStatus {
  DRAFT
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ARCHIVED
  /// Legacy values retained for existing databases.
  ACTIVE
  PAUSED
}

enum InvestigationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum InvestigationCategory {
  DOMAIN
  IP
  EMAIL
  USERNAME
  WEBSITE
  SOCIAL
  THREAT
  GENERAL
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TargetType {
  EMAIL
  USERNAME
  DOMAIN
  IP
  PHONE
  WEBSITE
  HASH
  PERSON
}

enum EntityType {
  PERSON
  EMAIL
  USERNAME
  DOMAIN
  IP
  PHONE
  WEBSITE
  ORGANIZATION
  ASN
  PUBLIC_PROFILE
  THREAT_INDICATOR
  LOCATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  REVIEWED
  RESOLVED
}

enum SourceStatus {
  OPERATIONAL
  SYNCING
  DEGRADED
  OFFLINE
}

enum ReportStatus {
  DRAFT
  FINAL
  ARCHIVED
}

model Tenant {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  users             User[]
  investigations    Investigation[]
  entities          Entity[]
  relationships     Relationship[]
  graphLayouts      GraphLayout[]
  findings          Finding[]
  intelligenceSources IntelligenceSource[]
  evidence          Evidence[]
  analystNotes      AnalystNote[]
  tasks             InvestigationTask[]
  reports           Report[]
  activityLogs      ActivityLog[]
  apiConfigurations ApiConfiguration[]
  domainResults     DomainIntelligenceResult[]
  ipResults         IpIntelligenceResult[]
  emailResults      EmailIntelligenceResult[]
  usernameResults   UsernameIntelligenceResult[]
  websiteResults    WebsiteIntelligenceResult[]
  socialResults     SocialIntelligenceResult[]
  threatResults     ThreatIntelligenceResult[]
  invitations       UserInvitation[]
  savedSearches     SavedSearch[]
  reportSchedules   ReportSchedule[]
  savedDashboards   SavedDashboard[]
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  createdAt DateTime @default(now())
  users     User[]
  permissions RolePermission[]
  invitations UserInvitation[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                    String           @id @default(cuid())
  tenantId              String
  roleId                String
  email                 String           @unique
  name                  String
  passwordHash          String
  isActive              Boolean          @default(true)
  tokenVersion          Int              @default(0)
  passwordResetTokenHash String?         @unique
  passwordResetExpiresAt DateTime?
  lastLoginAt           DateTime?
  mfaEnabled            Boolean          @default(false)
  mfaSecretEncrypted    String?
  mfaPendingSecretEncrypted String?
  mfaRecoveryCodes      Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                  Role             @relation(fields: [roleId], references: [id])
  ownedInvestigations   Investigation[]  @relation("InvestigationOwner")
  assignedInvestigations Investigation[] @relation("InvestigationAssignee")
  assignedTasks         InvestigationTask[] @relation("TaskAssignee")
  createdTasks          InvestigationTask[] @relation("TaskCreator")
  createdFindings       Finding[]       @relation("FindingCreator")
  analystNotes          AnalystNote[]
  authoredReports       Report[]         @relation("ReportAuthor")
  reportSchedules       ReportSchedule[] @relation("ReportScheduleCreator")
  savedDashboards       SavedDashboard[]
  activityLogs          ActivityLog[]
  apiConfigurations     ApiConfiguration[] @relation("ApiConfigurationOwner")
  sessions              UserSession[]
  sentInvitations       UserInvitation[] @relation("InvitationSender")
  savedSearches         SavedSearch[]
  @@index([tenantId])
}

model AdminAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  lastLoginAt  DateTime?
  mfaEnabled   Boolean  @default(false)
  mfaSecretEncrypted String?
  mfaPendingSecretEncrypted String?
  mfaRecoveryCodes Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AdminSession[]
}

model UserSession {
  id         String    @id
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AdminSession {
  id         String       @id
  adminId    String
  tokenHash  String       @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime     @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, createdAt])
  @@index([expiresAt])
}

model UserInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  roleId      String
  invitedById String?
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])
  invitedBy   User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([email])
  @@index([expiresAt])
}

model Investigation {
  id             String              @id @default(cuid())
  tenantId       String
  ownerId        String
  name           String
  description    String?
  category       InvestigationCategory @default(GENERAL)
  selectedModules Json?
  status         InvestigationStatus @default(DRAFT)
  progress       Int                 @default(0)
  failureReason  String?
  priority       InvestigationPriority @default(MEDIUM)
  deadline       DateTime?
  assigneeId     String?
  results        Json?
  retryCount     Int                 @default(0)
  maxRetries     Int                 @default(3)
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User                @relation("InvestigationOwner", fields: [ownerId], references: [id])
  assignee       User?               @relation("InvestigationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  targets        InvestigationTarget[]
  entities       Entity[]
  relationships  Relationship[]
  graphLayouts   GraphLayout[]
  findings       Finding[]
  evidence       Evidence[]
  tasks          InvestigationTask[]
  notes          AnalystNote[]
  reports        Report[]
  reportSchedules ReportSchedule[]
  activityLogs   ActivityLog[]
  jobs           InvestigationJob[]
  domainResults  DomainIntelligenceResult[]
  ipResults      IpIntelligenceResult[]
  emailResults   EmailIntelligenceResult[]
  usernameResults UsernameIntelligenceResult[]
  websiteResults  WebsiteIntelligenceResult[]
  socialResults   SocialIntelligenceResult[]
  threatResults   ThreatIntelligenceResult[]
  @@index([tenantId, status])
  @@index([ownerId])
  @@index([tenantId, category])
}

model InvestigationJob {
  id             String         @id @default(cuid())
  investigationId String
  attempt        Int            @default(1)
  status         JobStatus      @default(QUEUED)
  progress       Int            @default(0)
  currentStage   String?
  errorMessage   String?
  queuedAt       DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  investigation  Investigation  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  @@unique([investigationId, attempt])
  @@index([investigationId, status])
}

model InvestigationTarget {
  id             String         @id @default(cuid())
  investigationId String
  type           TargetType
  value          String
  label          String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  investigation  Investigation  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  @@unique([investigationId, type, value])
  @@index([investigationId])
}

model Entity {
  id             String          @id @default(cuid())
  tenantId       String
  investigationId String?
  type           EntityType
  value          String
  name           String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation?  @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  relationshipsFrom Relationship[] @relation("RelationshipFrom")
  relationshipsTo   Relationship[] @relation("RelationshipTo")
  findings       Finding[]
  @@index([tenantId, type])
  @@index([investigationId])
}

model Relationship {
  id             String        @id @default(cuid())
  tenantId       String
  investigationId String?
  fromEntityId   String
  toEntityId     String
  type           String
  confidence     Float?
  sourceReferences Json?
  evidenceQuality Float?
  corroborationScore Float?
  freshnessScore Float?
  metadata       Json?
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  fromEntity     Entity        @relation("RelationshipFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity       Entity        @relation("RelationshipTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  evidence       Evidence[]
  @@index([tenantId])
  @@index([fromEntityId])
  @@index([toEntityId])
}

model Finding {
  id             String          @id @default(cuid())
  tenantId       String
  investigationId String?
  entityId       String?
  createdById     String?
  title          String
  description    String?
  severity       Severity        @default(MEDIUM)
  status         FindingStatus   @default(OPEN)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  entity         Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("FindingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  evidence       Evidence[]
  @@index([tenantId, severity])
  @@index([investigationId])
}

model IntelligenceSource {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  type        String
  status      SourceStatus @default(OFFLINE)
  lastSyncAt  DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
}

model Evidence {
  id          String       @id @default(cuid())
  tenantId    String
  investigationId String?
  findingId   String?
  relationshipId String?
  domainResultId String?
  ipResultId  String?
  emailResultId String?
  usernameResultId String?
  websiteResultId String?
  socialResultId String?
  threatResultId String?
  sourceUrl   String?
  title       String?
  contentHash String?
  storageKey  String?
  screenshots Json?
  attachments Json?
  provenance  Json?
  chainOfCustody Json?
  metadata    Json?
  collectedAt DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation Investigation? @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  finding     Finding?     @relation(fields: [findingId], references: [id], onDelete: SetNull)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  domainResult DomainIntelligenceResult? @relation(fields: [domainResultId], references: [id], onDelete: Cascade)
  ipResult    IpIntelligenceResult? @relation(fields: [ipResultId], references: [id], onDelete: Cascade)
  emailResult EmailIntelligenceResult? @relation(fields: [emailResultId], references: [id], onDelete: Cascade)
  usernameResult UsernameIntelligenceResult? @relation(fields: [usernameResultId], references: [id], onDelete: Cascade)
  websiteResult WebsiteIntelligenceResult? @relation(fields: [websiteResultId], references: [id], onDelete: Cascade)
  socialResult SocialIntelligenceResult? @relation(fields: [socialResultId], references: [id], onDelete: Cascade)
  threatResult ThreatIntelligenceResult? @relation(fields: [threatResultId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([investigationId])
  @@index([findingId])
  @@index([relationshipId])
  @@index([domainResultId])
  @@index([ipResultId])
  @@index([emailResultId])
  @@index([usernameResultId])
  @@index([websiteResultId])
  @@index([socialResultId])
  @@index([threatResultId])
}

model GraphLayout {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  investigationId String?
  nodes          Json
  edges          Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation? @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  @@index([tenantId, updatedAt])
  @@index([investigationId])
}

model DomainIntelligenceResult {
  id              String        @id @default(cuid())
  tenantId        String
  investigationId String
  domain          String
  status          String
  data            Json
  sourceReferences Json?
  collectedAt     DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence        Evidence[]
  @@index([tenantId, domain])
  @@index([investigationId, collectedAt])
}

model IpIntelligenceResult {
  id               String        @id @default(cuid())
  tenantId         String
  investigationId  String
  ip               String
  status           String
  data             Json
  sourceReferences Json?
  collectedAt      DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  @@index([tenantId, ip])
  @@index([investigationId, collectedAt])
}

model EmailIntelligenceResult {
  id               String        @id @default(cuid())
  tenantId         String
  investigationId  String
  email            String
  status           String
  data             Json
  sourceReferences Json?
  collectedAt      DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  @@index([tenantId, email])
  @@index([investigationId, collectedAt])
}

model UsernameIntelligenceResult {
  id               String        @id @default(cuid())
  tenantId         String
  investigationId  String
  username         String
  status           String
  data             Json
  sourceReferences Json?
  collectedAt      DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  @@index([tenantId, username])
  @@index([investigationId, collectedAt])
}

model WebsiteIntelligenceResult {
  id               String        @id @default(cuid())
  tenantId         String
  investigationId  String
  url              String
  status           String
  data             Json
  sourceReferences Json?
  collectedAt      DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  @@index([tenantId, url])
  @@index([investigationId, collectedAt])
}

model SocialIntelligenceResult {
  id               String        @id @default(cuid())
  tenantId         String
  investigationId  String
  username         String
  status           String
  data             Json
  sourceReferences Json?
  collectedAt      DateTime      @default(now())
  expiresAt        DateTime
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  @@index([tenantId, username])
  @@index([investigationId, collectedAt])
  @@index([expiresAt])
}

model ThreatIntelligenceResult {
  id               String        @id @default(cuid())
  tenantId         String
  investigationId  String
  indicator        String
  indicatorType    String
  status           String
  data             Json
  sourceReferences Json?
  collectedAt      DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation    Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence         Evidence[]
  @@index([tenantId, indicator])
  @@index([tenantId, indicatorType])
  @@index([investigationId, collectedAt])
}

model AnalystNote {
  id             String        @id @default(cuid())
  tenantId       String
  investigationId String
  authorId       String
  content        String
  mentions       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  author         User          @relation(fields: [authorId], references: [id])
  @@index([tenantId, investigationId])
}

model InvestigationTask {
  id             String      @id @default(cuid())
  tenantId       String
  investigationId String
  title          String
  description    String?
  status         TaskStatus  @default(TODO)
  priority       InvestigationPriority @default(MEDIUM)
  assigneeId     String?
  createdById    String
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  assignee       User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User        @relation("TaskCreator", fields: [createdById], references: [id])
  @@index([tenantId, investigationId])
  @@index([assigneeId, status])
}

model Report {
  id             String        @id @default(cuid())
  tenantId       String
  investigationId String?
  authorId       String
  title          String
  content        Json?
  pdfData        Bytes?
  generatedAt    DateTime?
  investigationDate DateTime?
  scope          Json?
  template       String        @default("STANDARD")
  branding       Json?
  executiveSummary String?
  evidenceAppendix Json?
  searchText     String?
  status         ReportStatus  @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  author         User          @relation("ReportAuthor", fields: [authorId], references: [id])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ReportSchedule {
  id             String   @id @default(cuid())
  tenantId       String
  investigationId String
  createdById    String
  name           String
  template       String   @default("STANDARD")
  frequency      String   @default("WEEKLY")
  enabled        Boolean  @default(true)
  titleTemplate  String?
  branding       Json?
  nextRunAt      DateTime
  lastRunAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigation  Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("ReportScheduleCreator", fields: [createdById], references: [id])
  @@index([tenantId, enabled, nextRunAt])
}

model SavedDashboard {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  layout    Json
  filters   Json?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, userId, isPinned])
}

model SavedSearch {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  name        String
  query       String?
  filters     Json?
  sort        String   @default("UPDATED_DESC")
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, userId, isPinned])
}

model ActivityLog {
  id              String        @id @default(cuid())
  tenantId        String?
  userId          String?
  investigationId String?
  action          String
  entityType      String?
  entityId        String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  chainIndex      Int?          @unique
  previousHash    String?
  integrityHash   String?
  createdAt       DateTime      @default(now())
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([investigationId])
  @@index([chainIndex])
}

model ApiConfiguration {
  id            String   @id @default(cuid())
  tenantId      String
  ownerId       String?
  name          String
  provider      String
  encryptedConfig String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?    @relation("ApiConfigurationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  @@index([tenantId, provider])
}
